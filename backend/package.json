{
  "name": "backend",
  "version": "1.0.50",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "bun run --watch src/index.ts",
    "db:master:generate": "drizzle-kit generate --config=drizzle/master.config.ts",
    "db:master:migrate": "drizzle-kit migrate --config=drizzle/master.config.ts",
    "db:tenant:generate": "drizzle-kit generate --config=drizzle/tenant.config.ts",
    "db:tenant:migrate": "drizzle-kit migrate --config=drizzle/tenant.config.ts",
    "db:tenant:migrate:all": "bun scripts/migrate-tenants.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "drizzle-orm": "^0.45.2",
    "elysia": "latest"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "bun-types": "latest",
    "drizzle-kit": "^0.31.10"
  },
  "module": "src/index.js"
}
