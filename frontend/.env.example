# Used by the browser (client-side rendering) to reach the API. Baked in by `vite build`.
# Copy to frontend/.env and adjust. Leave unset for dev, which defaults to http://localhost:3000.
# For production, point at the public API origin (e.g. http://<VPS_IP>:3000 or the same-origin proxy URL).
VITE_API_BASE_URL=http://localhost:3000